<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VM Setup Suite" Height="720" Width="940" MinHeight="600" MinWidth="820" WindowStartupLocation="CenterScreen"
        Background="#0A1428" FontFamily="Segoe UI" FontSize="13" Foreground="#E6F1FF">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E6F1FF"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E6F1FF"/><Setter Property="Margin" Value="0,3"/></Style>
        <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#E6F1FF"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1730"/><Setter Property="Foreground" Value="#E6F1FF"/><Setter Property="BorderBrush" Value="#1E3560"/><Setter Property="Padding" Value="6,5"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0B1730"/><Setter Property="Foreground" Value="#E6F1FF"/><Setter Property="BorderBrush" Value="#1E3560"/><Setter Property="Padding" Value="6,5"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1B2E55"/><Setter Property="Foreground" Value="#E6F1FF"/><Setter Property="BorderBrush" Value="#1E3560"/><Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#24407A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#1E9BFF"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#7A2436"/></Style>
        <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#38D6FF"/><Setter Property="Margin" Value="0,10,0,4"/></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#8FA3C7"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="Card" TargetType="RadioButton"><Setter Property="Margin" Value="0,5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="bd" Background="#0F1D38" BorderBrush="#1E3560" BorderThickness="1" CornerRadius="8" Padding="14,10"><ContentPresenter/></Border>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#38D6FF"/><Setter TargetName="bd" Property="Background" Value="#14284D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#111F3A" BorderBrush="#1E3560" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image Name="imgLogo" Width="44" Height="44" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="VM SETUP SUITE" FontSize="17" FontWeight="Bold" Foreground="#38D6FF"/><TextBlock Name="lblStepTitle" Text="Passo 1 di 4 - Scegli il profilo" Style="{StaticResource Hint}"/></StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Name="lblComputer" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Name="lblInternet" Style="{StaticResource Hint}" HorizontalAlignment="Right"/></StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#111F3A" BorderBrush="#1E3560" BorderThickness="1" CornerRadius="8" Padding="18">
            <Grid>
                <ScrollViewer Name="pnlProfile" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="700" HorizontalAlignment="Left">
                    <TextBlock Text="Profilo di configurazione" Style="{StaticResource H2}"/>
                    <StackPanel Name="pnlProfiles"/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="I profili sono file JSON nella cartella Profili: puoi modificarli con un editor di testo (vedi _schema.md) e aggiungerne di nuovi per sede o cliente."/>
                    <Button Name="btnOpenProfiles" Content="Apri cartella Profili" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel></ScrollViewer>
                <ScrollViewer Name="pnlOptions" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Passi da eseguire" Style="{StaticResource H2}"/>
                        <StackPanel Name="pnlSteps"/>
                        <TextBlock Text="Applicazioni aggiuntive (ID winget, uno per riga)" Style="{StaticResource H2}"/>
                        <TextBox Name="txtAppsExtra" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Identita' del PC" Style="{StaticResource H2}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Nome PC:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Name="txtNomePC"/></Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Max 15 caratteri, lettere/numeri/trattino. Vuoto = invariato."/>
                        <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Dominio AD:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Name="txtDominio"/></Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Se compilato (e il passo 'Join al dominio' e' attivo) verranno chieste le credenziali all'avvio."/>
                        <TextBlock Text="Nuovo utente locale (facoltativo)" Style="{StaticResource H2}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Nome:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Name="txtUser" Grid.Column="1"/>
                            <TextBlock Text="Password:" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,8,0"/><PasswordBox Name="pwdUser" Grid.Column="3"/></Grid>
                        <CheckBox Name="chkUserAdmin" Content="Amministratore" Margin="0,6,0,0"/>
                        <TextBlock Text="Sicurezza" Style="{StaticResource H2}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Salva chiave BitLocker in:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Name="txtBlKey"/><Button Name="btnBlBrowse" Grid.Column="2" Content="..." Padding="8,5" Margin="6,0,0,0"/></Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Usato solo se il passo BitLocker e' attivo. Consigliata una cartella di rete o una chiavetta, non il PC stesso."/>
                        <CheckBox Name="chkRestorePoint" Content="Crea un punto di ripristino prima di iniziare" IsChecked="True" Margin="0,10,0,0"/>
                        <CheckBox Name="chkRebootEnd" Content="Riavvia automaticamente al termine se necessario" IsChecked="False"/>
                    </StackPanel>
                </Grid></ScrollViewer>
                <Grid Name="pnlRun" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Name="lblRunTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Name="btnCancel" Grid.Column="1" Content="Annulla" Style="{StaticResource Danger}"/></Grid>
                    <TextBox Name="txtLog" Grid.Row="1" IsReadOnly="True" Background="#060D1C" Foreground="#9FE8FF" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8" Margin="0,8"/>
                    <TextBlock Name="lblStatus" Grid.Row="2" Style="{StaticResource Hint}"/>
                    <ProgressBar Name="progressBar" Grid.Row="3" Height="14" Margin="0,6,0,0" Minimum="0" Maximum="100" Foreground="#38D6FF" Background="#0B1730" BorderBrush="#1E3560"/>
                </Grid>
                <StackPanel Name="pnlDone" Visibility="Collapsed" VerticalAlignment="Center" MaxWidth="700">
                    <TextBlock Name="lblDoneTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Name="lblDoneText" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <WrapPanel><Button Name="btnOpenLog" Content="Apri log" Margin="0,0,8,8"/><Button Name="btnReboot" Content="Riavvia ora" Style="{StaticResource Primary}" Margin="0,0,8,8"/><Button Name="btnRestart" Content="Nuova configurazione" Margin="0,0,8,8"/></WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Name="btnBack" Content="Indietro" IsEnabled="False"/>
            <TextBlock Grid.Column="1" Text="vm technology - VM Setup Suite v1.0" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0"/>
            <Button Name="btnNext" Grid.Column="2" Content="Avanti" Style="{StaticResource Primary}" Padding="24,8"/>
        </Grid>
    </Grid>
</Window>
